# ---- Turso (libSQL edge database) ----
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ---- Session signing secret (generate with: openssl rand -base64 48) ----
AUTH_SECRET=replace-with-a-long-random-string

# ---- Vercel Blob read/write token (from vercel.com/storage) ----
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# ---- Operator code used to generate invite codes via /api/codes ----
ADMIN_CODE=change-me

# ---- Public display name ----
NEXT_PUBLIC_APP_NAME=匿名聊天空间
